  "commentary": {
    "headline": "Revenue more than doubled compared with the first nine months of 2025, but costs rose faster. The company made a loss of GH¢ 3.32M and relied on external borrowing of GH¢ 18.77M to finance its activities.",
    "keyMessages": [
      {
        "title": "Revenue more than doubled",
        "text": "Revenue for January to September 2026 was GH¢ 41.49M, 134% more than the same months of 2025. Most of the increase came from Other Projects, which grew from GH¢ 274K to GH¢ 20.76M.",
        "evidence": [
          {
            "label": "Revenue, 9M 2026",
            "value": 41494122.37,
            "format": "money",
            "source": "sep26b",
            "ref": "Income statement"
          },
          {
            "label": "Revenue, 9M 2025",
            "value": 17705638.1,
            "format": "money",
            "source": "sep26b",
            "ref": "Income statement"
          },
          {
            "label": "Other Projects revenue, 9M 2026",
            "value": 20764586.24,
            "format": "money",
            "source": "sep26b",
            "ref": "Note 4"
          },
          {
            "label": "Other Projects revenue, 9M 2025",
            "value": 274439.0,
            "format": "money",
            "source": "sep26b",
            "ref": "Note 4"
          }
        ]
      },
      {
        "title": "Costs grew faster than revenue",
        "text": "Direct costs rose 179% and administrative expenses rose 135%, while revenue rose 134%. Gross profit was therefore 23.9% of revenue, down from 36.1%.",
        "evidence": [
          {
            "label": "Direct cost, 9M 2026",
            "value": 31570736.63,
            "format": "money",
            "source": "sep26b",
            "ref": "Income statement"
          },
          {
